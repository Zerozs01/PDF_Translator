{
  "name": "pdf_translator",
  "version": "1.0.0",
  "description": "**Next-Gen Local OCR & Manga Translation Engine**\r แอปพลิเคชันเวอร์ชันยกเครื่องใหม่ (Rebirth) ที่สร้างขึ้นเพื่อแก้ปัญหาความล่าช้าและการแยกแยะองค์ประกอบภาพที่ไม่แม่นยำ โดยเน้นการประมวลผลแบบ Offline 100% และมี UI ที่ยืดหยุ่นสูงสุด",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "set \"OCR_PYTHON_PATH=%CD%\\.venv-ocr\\Scripts\\python.exe\" && vite",
    "benchmark:memory-leak": "electron . --benchmark-memory-leak",
    "build": "tsc && vite build && electron-builder",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ocr:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap_ocr_env.ps1",
    "fonts:overlay:download": "node scripts/download-overlay-fonts.js",
    "fonts:overlay:download:force": "node scripts/download-overlay-fonts.js --force",
    "ocr:regression": "node scripts/run-ocr-regression.mjs --out .tmp-ocr-current.json && node scripts/ocr-regression-report.js --cand .tmp-ocr-current.json --base public/fixtures/ocr/baseline/ocr-v38-panel.json --expect public/fixtures/ocr/manga/expectations.json --out .tmp-ocr-report.json",
    "ocr:regression:partial": "node scripts/run-ocr-regression.mjs --skip-missing --out .tmp-ocr-current.json && node scripts/ocr-regression-report.js --partial --cand .tmp-ocr-current.json --base public/fixtures/ocr/baseline/ocr-v38-panel.json --expect public/fixtures/ocr/manga/expectations.json --out .tmp-ocr-report.json",
    "ocr:regression:paddle": "node scripts/run-ocr-regression.mjs --skip-missing --engine paddleocr --out .tmp-ocr-current-paddle.json && node scripts/ocr-regression-report.js --partial --cand .tmp-ocr-current-paddle.json --base public/fixtures/ocr/baseline/ocr-v38-panel.json --expect public/fixtures/ocr/manga/expectations.json --out .tmp-ocr-report-paddle.json",
    "ocr:regression:easy": "node scripts/run-ocr-regression.mjs --skip-missing --engine easyocr --out .tmp-ocr-current-easy.json && node scripts/ocr-regression-report.js --partial --cand .tmp-ocr-current-easy.json --base public/fixtures/ocr/baseline/ocr-v38-panel.json --expect public/fixtures/ocr/manga/expectations.json --out .tmp-ocr-report-easy.json",
    "ocr:fixtures:check": "node scripts/ocr-fixture-audit.mjs --manifest public/fixtures/ocr/manga/expectations.json",
    "ocr:fixtures:check:kor": "node scripts/ocr-fixture-audit.mjs --manifest public/fixtures/ocr/manga/expectations.json --require-language kor",
    "translate:argos:install": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path .venv-ocr) { .venv-ocr\\Scripts\\python.exe -m pip install argostranslate } else { python -m pip install argostranslate }\"",
    "translate:argos:doctor": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path .venv-ocr) { .venv-ocr\\Scripts\\python.exe -c \\\"import argostranslate.translate as t; print('installed_languages=', [l.code for l in t.get_installed_languages()])\\\" } else { python -c \\\"import argostranslate.translate as t; print('installed_languages=', [l.code for l in t.get_installed_languages()])\\\" }\"",
    "translate:argos:install-model": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path .venv-ocr) { .venv-ocr\\Scripts\\python.exe scripts/argos_install_pair.py --from en --to th } else { python scripts/argos_install_pair.py --from en --to th }\"",
    "translate:argos:install-model:ko-th": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path .venv-ocr) { .venv-ocr\\Scripts\\python.exe scripts/argos_install_pair.py --from ko --to en } else { python scripts/argos_install_pair.py --from ko --to en }\"",
    "translate:argos:install-model:es-th": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path .venv-ocr) { .venv-ocr\\Scripts\\python.exe scripts/argos_install_pair.py --from es --to en } else { python scripts/argos_install_pair.py --from es --to en }\"",
    "ocr:benchmark:strict": "node scripts/ocr-benchmark-matrix.mjs",
    "ocr:benchmark": "node scripts/ocr-benchmark-matrix.mjs",
    "ocr:benchmark:partial": "node scripts/ocr-benchmark-matrix.mjs --skip-missing",
    "ocr:gate": "node scripts/ocr-benchmark-matrix.mjs --fail-on-risk",
    "ocr:gate:kor": "node scripts/ocr-benchmark-matrix.mjs --fail-on-risk --require-language kor",
    "ocr:benchmark:ci": "node scripts/ocr-benchmark-matrix.mjs --fail-on-risk",
    "test:ocr:compare-pipeline": "node scripts/compare-pipeline.mjs",
    "postinstall": "node scripts/postinstall-electron.js && node scripts/postinstall-ocr.js && node scripts/download-overlay-fonts.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zerozs01/PDF_Translator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Zerozs01/PDF_Translator/issues"
  },
  "homepage": "https://github.com/Zerozs01/PDF_Translator#readme",
  "build": {
    "appId": "com.pdftranslator.app",
    "productName": "PDF Translator",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist/fixtures/**/*",
      "!node_modules/@napi-rs/canvas-android-arm64"
    ],
    "extraResources": [
      {
        "from": "scripts/external_ocr_bridge.py",
        "to": "ocr-bridge/external_ocr_bridge.py"
      },
      {
        "from": "scripts/argos_translate_bridge.py",
        "to": "ocr-bridge/argos_translate_bridge.py"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns"
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@storybook/addon-a11y": "^10.2.1",
    "@storybook/addon-docs": "^10.2.1",
    "@storybook/addon-onboarding": "^10.2.1",
    "@storybook/addon-vitest": "^10.2.1",
    "@storybook/react-vite": "^10.2.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "storybook": "^10.2.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "lucide-react": "^0.562.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-pdf": "^10.2.0",
    "zustand": "^5.0.9"
  }
}
